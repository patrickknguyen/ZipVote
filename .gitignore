# Dependencies and build output (recreated by npm install / npm run build)
node_modules/
.next/
out/
*.tsbuildinfo

# Python cache
__pycache__/
*.pyc

# Secrets: never commit API keys
.env
.env.*
!.env.example

# macOS
.DS_Store

# Local Python environment and run logs
.venv/
*.log

# Scout's copies of candidates' web pages. They're other people's text, and
# Scout can rebuild them (python -m agents.scout --as-of DATE). The
# .sources.json records next to them stay in git: they list what was read
# and skipped, with links to the exact versions.
data/raw/*.txt

# Wedge's saved model answers, so unchanged reruns make no calls
data/cache/
